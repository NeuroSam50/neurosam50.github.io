{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-astro"],
	"overrides": [{ "files": "*.astro", "options": { "parser": "astro" } }]
}
