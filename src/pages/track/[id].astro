---
import Layout from "../../layouts/Layout.astro";
import TrackPage from "../../components/TrackPage";
import {
	fetchPublishedTracks,
	type StaticTrack,
} from "../../lib/supabaseServer";

export async function getStaticPaths() {
	const tracks = await fetchPublishedTracks();
	return tracks.map((track) => ({
		params: { id: track.id },
		props: { track },
	}));
}

const { track } = Astro.props as { track: StaticTrack };

const description = `${track.title} - ${track.artist}. Слушайте, скачивайте и обсуждайте трек на сайте НейроСэм.`;
---

<Layout
	title={`${track.title} - ${track.artist} | НейроСэм`}
	description={description}
	image={track.coverPath || undefined}
>
	<TrackPage client:only="react" trackId={track.id} />
</Layout>
